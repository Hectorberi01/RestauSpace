{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Identity": {
    "AccessTokens": {
      "Issuer": "saasrestaurant",
      "Audience": "saasrestaurant-api"
    },
    "Emails": {
      "ProductName": "RestauSpace",
      "WriteToLog": false,
      "Links": {
        "VerifyEmail": "",
        "ResetPassword": "",
        "AcceptInvitation": ""
      },
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Security": "StartTls",
        "FromAddress": "",
        "FromName": "RestauSpace"
      }
    },
    "Passwords": {
      "RejectCompromised": true
    },
    "Sessions": {
      "FamilyMaxDays": 90,
      "TillSessionHours": 12
    }
  },
  "Authorization": {
    "PlatformAdminEmails": []
  },
  "Sales": {
    "DemoRequestNotificationEmail": "",
    "AdminUrl": "http://localhost:3000"
  },
  "Observability": {
    "ServiceName": "saasrestaurant-api",
    "OtlpEndpoint": "",
    "TraceSampleRatio": 1.0,
    "PlatformMetrics": {
      "Enabled": true,
      "IntervalSeconds": 60
    }
  },
  "Fiscal": {
    "TokenKey": "",
    "SandboxBaseUrl": "https://developper.impots.bj/sygmef-emcf/api/",
    "ProductionBaseUrl": "https://sygmef.impots.bj/emcf/api/"
  },
  "Backups": {
    "DatabaseName": "",
    "RetentionDays": 30,
    "KeepMin": 7,
    "Schedule": {
      "Enabled": true,
      "DailyAtUtc": "02:30"
    },
    "RestoreDelayMinutes": 5,
    "StaleAfterMinutes": 60,
    "DownloadLinkMinutes": 5,
    "Storage": {
      "Endpoint": "",
      "Region": "gra",
      "Bucket": "",
      "AccessKeyId": "",
      "SecretAccessKey": ""
    }
  }
}
