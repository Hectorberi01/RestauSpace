NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
# API qui reçoit les demandes de démo (POST /v1/demo-requests) ; son origine est autorisée dans la CSP.
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE_BJ=
NEXT_PUBLIC_CONTACT_PHONE_FR=
# Commande en ligne (/commander) : clé publique de l'application de vente « Site web » créée dans la console
# (Paramètres › Vente en ligne). Déclarez l'adresse de ce site comme origine, et <site>/commande comme page de retour.
NEXT_PUBLIC_STOREFRONT_KEY=
# Démos des modèles de site (/modeles) : <url>/<slug>/ ; son origine est autorisée en iframe dans la CSP.
# En local : http://localhost:3005
NEXT_PUBLIC_DEMO_BASE_URL=https://demo.restauspace.com
