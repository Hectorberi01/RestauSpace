# URL de l'API SaasRestaurant (sans /v1). L'origine est aussi autorisée dans la CSP (connect-src).
NEXT_PUBLIC_API_URL=http://localhost:5080
# Origines du stockage des photos (R2), séparées par des espaces : autorisées dans la CSP (img-src, connect-src).
# Inutile en développement : le stockage local est servi par l'API. Ex. : https://<compte>.r2.cloudflarestorage.com
NEXT_PUBLIC_FILES_ORIGINS=
# Adresse du site public (restaurantos-site) : encodée dans les QR codes des tables (menu public). En développement : http://localhost:3002
NEXT_PUBLIC_SITE_URL=
