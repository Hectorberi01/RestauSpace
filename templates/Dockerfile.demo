# Démos publiques des modèles de sites (demo.restauspace.com) : chaque modèle est construit en site statique sous
# /<slug>, puis servi par nginx avec la page de paiement simulé. Contexte de build : le dossier templates/.

FROM node:22-alpine AS maquis
WORKDIR /src
COPY maquis/package.json maquis/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY maquis/ ./
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_STOREFRONT_KEY
ENV TEMPLATE_BASE_PATH=/maquis \
    NEXT_PUBLIC_DEMO=1 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_STOREFRONT_KEY=${NEXT_PUBLIC_DEMO_STOREFRONT_KEY} \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY _demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY _demo/index.html /usr/share/nginx/html/index.html
COPY _demo/paiement-demo/ /usr/share/nginx/html/paiement-demo/
COPY --from=maquis /src/out/ /usr/share/nginx/html/maquis/
EXPOSE 8080
