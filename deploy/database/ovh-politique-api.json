{
  "Statement": [
    {
      "Sid": "ApiBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::restauspace-backups"]
    },
    {
      "Sid": "ApiLectureSeule",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::restauspace-backups/*"]
    }
  ]
}
