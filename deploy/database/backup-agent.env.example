# Agent de sauvegarde (backup-agent.sh) : /etc/restauspace-backup.env, root, 600. Jamais dans le dépôt.

# Base visée (l'agent ignore le nom écrit dans les lignes).
DB_NAME=es_restaurant
DB_OWNER=es_restaurant_user
DB_APP=es_restaurant_app
PG_BIN=/usr/lib/postgresql/18/bin
# Socket local par défaut ; PGHOST (dossier du socket) et PGPORT seulement si différents.
#PGHOST=/var/run/postgresql
#PGPORT=5432

# Chiffrement age. Clé publique : ligne « public key » de age-keygen.
BACKUP_AGE_RECIPIENT=age1...
# Clé privée sur ce serveur (nécessaire pour restaurer), root 600, plus une copie hors ligne.
# Le chiffrement protège la copie dans le stockage, pas ce serveur.
BACKUP_AGE_IDENTITY=/root/restauspace-backup/age-identity.txt

# Stockage OVH (S3). Clé de l'agent : lecture, écriture et suppression sur ce seul bucket.
RCLONE_REMOTE=ovh:restauspace-backups
RCLONE_CONFIG_OVH_TYPE=s3
# Other avec rclone < 1.64 (paquet Debian/Ubuntu), OVHcloud sinon.
RCLONE_CONFIG_OVH_PROVIDER=Other
RCLONE_CONFIG_OVH_ENDPOINT=https://s3.gra.io.cloud.ovh.net
RCLONE_CONFIG_OVH_REGION=gra
RCLONE_CONFIG_OVH_ACCESS_KEY_ID=
RCLONE_CONFIG_OVH_SECRET_ACCESS_KEY=
# Le bucket existe déjà : pas de tentative de création.
RCLONE_CONFIG_OVH_NO_CHECK_BUCKET=true

# Dossier de travail (700) : fichiers temporaires, effacés à chaque passage.
WORK_DIR=/var/lib/restauspace-backup

# Restauration depuis le back-office : désactivée tant que ce n'est pas true.
RESTORE_ENABLED=false
# Place libre exigée en plus de la taille de la base (+20 %), en Mo.
#RESTORE_DISK_MARGIN_MB=1024

# Durée maximale d'un pg_dump ou d'un pg_restore, en minutes.
#JOB_TIMEOUT_MINUTES=360

# Surveillance facultative (ex. healthchecks.io) : appelée après chaque sauvegarde, /fail en cas d'échec.
#BACKUP_PING_URL=https://hc-ping.com/<uuid>
