# Serveur de base de données. Copier en .env, chmod 600.
POSTGRES_VERSION=16
POSTGRES_DB=es_restaurant
# Superutilisateur : seulement en local et pour la sauvegarde, jamais pour l'application (pg_hba.conf le refuse).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Comptes de l'application, créés à l'installation (roles.sh). Noms en minuscules ; mots de passe : lettres et chiffres.
# Propriétaire du schéma (migrations) : POSTGRES_USER / POSTGRES_PASSWORD de deploy/production/.env.
APP_OWNER_USER=es_restaurant_user
APP_OWNER_PASSWORD=
# Lecture et écriture des données seulement (l'API) : DATABASE_APP_USER / DATABASE_APP_PASSWORD de deploy/production/.env.
APP_USER=es_restaurant_app
APP_PASSWORD=
# IP privée de ce serveur : 5432 n'écoute que sur le réseau privé, jamais sur l'IP publique.
BIND_ADDRESS=10.10.0.2
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=150
# Environ 25 % de la mémoire du serveur.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_SLOW_QUERY_MS=1000

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
