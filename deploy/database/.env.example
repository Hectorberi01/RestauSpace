# Serveur de base de données. Copier en .env, chmod 600.
POSTGRES_VERSION=16
POSTGRES_DB=es_restaurant
# En minuscules (PostgreSQL met les noms non cités en minuscules).
POSTGRES_USER=es_restaurant_user
# Lettres et chiffres seulement ; le même que dans deploy/production/.env.
POSTGRES_PASSWORD=
# IP privée de ce serveur : 5432 n'écoute que sur le réseau privé, jamais sur l'IP publique.
BIND_ADDRESS=10.10.0.2
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=150
# Environ 25 % de la mémoire du serveur.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_SLOW_QUERY_MS=1000

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
