# Variables de docker compose (serveur applicatif). Copier en .env, chmod 600, ne JAMAIS versionner .env.

# Domaine racine : site sur DOMAIN (www. redirigé), console sur app., API sur api., back-office sur admin.
DOMAIN=restauspace.com

# Traefik déjà installé sur le serveur. Réseau propre à RestauSpace, auquel Traefik est ajouté (README, « Réseaux ») :
# jamais le réseau partagé avec un autre projet. EDGE_SUBNET : son sous-réseau, seule source acceptée de X-Forwarded-For.
TRAEFIK_NETWORK=restauspace-edge
EDGE_SUBNET=172.30.250.0/28
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Back-office ET routes /v1/admin de l'API : adresses autorisées (CIDR, séparées par des virgules).
# 0.0.0.0/0 = tout le monde : à restreindre (ex. 203.0.113.7/32) avant l'ouverture.
ADMIN_ALLOWED_IPS=0.0.0.0/0

# Registre des images construites par Jenkins (barre finale incluse). Vide : images construites sur ce serveur.
IMAGE_REGISTRY=ghcr.io/hectorberi01/
# Étiquette des images ; deploy.sh la remplit avec le commit.
RELEASE=latest

# PostgreSQL sur le serveur de base. Mot de passe sans « ; » (il est recopié dans une chaîne de connexion).
DATABASE_HOST=10.10.0.2
DATABASE_PORT=5432
POSTGRES_DB=es_restaurant
# Propriétaire du schéma : migrations seulement. Jamais superutilisateur (deploy/database/app-roles.sql).
POSTGRES_USER=es_restaurant_user
POSTGRES_PASSWORD=
# Compte de l'API : lecture et écriture des données seulement (droits posés à chaque déploiement par db-grants.sql).
# Vide : l'API utilise le propriétaire.
DATABASE_APP_USER=es_restaurant_app
DATABASE_APP_PASSWORD=
# Require : chiffré. Disable : seulement sur un réseau privé entre serveurs. Même choix en minuscules pour psql (db-grants).
DATABASE_SSL_MODE=Require
DATABASE_PGSSLMODE=require
DATABASE_POOL_SIZE=50

# Observabilité (autre serveur) : URL OTLP/HTTP de son collecteur et jeton partagé. Vide = aucun envoi.
OBSERVABILITY_OTLP_URL=https://otlp.observabilite.restauspace.com
OBSERVABILITY_TOKEN=

# Variables de build (NEXT_PUBLIC_*) : FILES_ORIGINS, ADMIN_IDLE_MINUTES, STOREFRONT_KEY, contacts et réseaux.
# Avec IMAGE_REGISTRY (images Jenkins), elles vont dans build.env de Jenkins, pas ici : voir build.env.example.
# Sans IMAGE_REGISTRY (build sur ce serveur), les recopier ici.
