# Variables de docker compose (serveur applicatif). Copier en .env, chmod 600, ne JAMAIS versionner .env.

# Domaine racine : site sur DOMAIN (www. redirigé), console sur app., API sur api., back-office sur admin.
DOMAIN=restauspace.com

# Traefik déjà installé sur le serveur.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Back-office : adresses autorisées (CIDR, séparées par des virgules). 0.0.0.0/0 = tout le monde.
ADMIN_ALLOWED_IPS=0.0.0.0/0
ADMIN_IDLE_MINUTES=30

# Registre des images construites par Jenkins (barre finale incluse). Vide : images construites sur ce serveur.
IMAGE_REGISTRY=ghcr.io/hectorberi01/
# Étiquette des images ; deploy.sh la remplit avec le commit.
RELEASE=latest

# PostgreSQL sur le serveur de base. Mot de passe sans « ; » (il est recopié dans une chaîne de connexion).
DATABASE_HOST=10.10.0.2
DATABASE_PORT=5432
POSTGRES_DB=ES_RESTAURANT
POSTGRES_USER=ES_RESTAURANT_USER
POSTGRES_PASSWORD=
# Require : chiffré. Disable : seulement sur un réseau privé entre serveurs.
DATABASE_SSL_MODE=Require
DATABASE_POOL_SIZE=50

# Observabilité (autre serveur) : URL OTLP/HTTP de son collecteur et jeton partagé. Vide = aucun envoi.
OBSERVABILITY_OTLP_URL=https://otlp.observabilite.restauspace.com
OBSERVABILITY_TOKEN=

# Console : origines du stockage des photos (R2) autorisées dans sa CSP, séparées par des espaces.
FILES_ORIGINS=https://<compte>.r2.cloudflarestorage.com

# Site public : clé de l'application de vente « Site web » (console > Vente en ligne), contacts et réseaux.
STOREFRONT_KEY=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_PHONE_BJ=
CONTACT_PHONE_FR=
NEWSLETTER_URL=
SOCIAL_FACEBOOK=
SOCIAL_GITHUB=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_YOUTUBE=
