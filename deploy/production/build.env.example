# Variables de build des images, pour Jenkins (identifiant « restauspace-build-env », type Secret file).
# Valeurs publiques (inscrites dans le code envoyé au navigateur) : AUCUN secret ici.
# DOMAIN et les contacts doivent être les mêmes que dans le .env du VPS.
DOMAIN=restauspace.com
# Architecture du VPS : linux/amd64 (la plupart), linux/arm64 (Hetzner CAX, Ampere…).
BUILD_PLATFORM=linux/amd64
ADMIN_IDLE_MINUTES=30
# Obligatoire pour les photos : l'AccountId R2 d'api.env (voir README, « Photos »).
FILES_ORIGINS=https://<AccountId>.r2.cloudflarestorage.com
STOREFRONT_KEY=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_PHONE_BJ=
CONTACT_PHONE_FR=
NEWSLETTER_URL=
SOCIAL_FACEBOOK=
SOCIAL_GITHUB=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_YOUTUBE=
