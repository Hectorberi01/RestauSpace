# Configuration de l'API (Production). Copier en api.env, chmod 600, ne JAMAIS versionner.
# Les clés « 32 octets base64 » : ./generate-secrets.sh les produit.
# La chaîne de connexion PostgreSQL, l'envoi OTLP et le proxy sont fixés dans docker-compose.yml (depuis .env).

# --- Clés (32 octets, base64). Les CHANGER rend illisible ce qu'elles chiffrent : à garder précieusement.
Identity__AccessTokens__SigningKey=
Identity__TwoFactor__SecretKey=
Payments__CredentialsKey=
Notifications__CredentialsKey=
Notifications__OtpKey=
Integrations__SecretsKey=
Fiscal__TokenKey=
Storefront__TrackingKey=
Files__PublicMedia__SigningKey=

# --- Administrateurs de la plateforme (back-office)
Authorization__PlatformAdminEmails__0=admin@restauspace.com
# Back-office réservé aux comptes avec la validation en deux étapes (proposée à la première connexion).
Authorization__PlatformAdminRequireTwoFactor=true

# --- Navigateurs autorisés (CORS)
Cors__AllowedOrigins__0=https://restauspace.com
Cors__AllowedOrigins__1=https://www.restauspace.com
Cors__AllowedOrigins__2=https://app.restauspace.com
Cors__AllowedOrigins__3=https://admin.restauspace.com

# --- E-mails de compte (vérification, mot de passe, invitation)
Identity__Emails__ProductName=RestauSpace
Identity__Emails__Smtp__Host=
Identity__Emails__Smtp__Port=587
Identity__Emails__Smtp__Security=StartTls
Identity__Emails__Smtp__Username=
Identity__Emails__Smtp__Password=
Identity__Emails__Smtp__FromAddress=
Identity__Emails__Smtp__FromName=RestauSpace
Identity__Emails__Links__VerifyEmail=https://app.restauspace.com/verifier-email?token={token}
Identity__Emails__Links__ResetPassword=https://app.restauspace.com/reinitialiser?token={token}
Identity__Emails__Links__AcceptInvitation=https://app.restauspace.com/activer?token={token}
Identity__Passwords__RejectCompromised=true

# --- Adresses publiques
Payments__PublicApiBaseUrl=https://api.restauspace.com
Payments__CheckoutReturnUrl=https://restauspace.com
Payments__EnableSandbox=false
Billing__OnlinePayment__ReturnUrl=https://app.restauspace.com/abonnement
Staff__ConsoleBaseUrl=https://app.restauspace.com
Reporting__PublicBaseUrl=https://app.restauspace.com
Sales__AdminUrl=https://admin.restauspace.com
Sales__DemoRequestNotificationEmail=
Notifications__UnsubscribePageUrl=https://restauspace.com/desinscription
Notifications__DefaultLanguage=fr
Notifications__EnableFakeProvider=false
# SMS + WhatsApp déclenchés par les visiteurs du site, par restaurant et par heure (0 = sans plafond).
Notifications__AnonymousSmsPerTenantPerHour=100

# --- Fichiers : Cloudflare R2
Files__Storage=R2
Files__R2__AccountId=
Files__R2__AccessKeyId=
Files__R2__SecretAccessKey=
Files__R2__Bucket=
Files__PublicMedia__BaseUrl=https://api.restauspace.com

# --- Commande en ligne : Cloudflare Turnstile (anti-robot), facultatif
Storefront__Turnstile__SiteKey=
Storefront__Turnstile__SecretKey=

# --- Facturation des abonnements : émetteur des factures
Billing__InvoiceIssuer__Name=RestauSpace
Billing__InvoiceIssuer__Address=
Billing__InvoiceIssuer__TaxId=
Billing__InvoiceIssuer__RegistrationNumber=
Billing__InvoiceIssuer__Email=

# --- Facture normalisée (Bénin, e-MECeF)
Fiscal__ProductionBaseUrl=https://sygmef.impots.bj/emcf/api/

# --- Sauvegardes de la base (exécutées par l'agent du serveur de base)
# Base : vide = celle de la chaîne de connexion.
Backups__DatabaseName=
Backups__RetentionDays=30
Backups__KeepMin=7
Backups__Schedule__Enabled=true
Backups__Schedule__DailyAtUtc=02:30
Backups__RestoreDelayMinutes=5
Backups__StaleAfterMinutes=60
Backups__DownloadLinkMinutes=5
# OVH Object Storage. Clé en LECTURE seule (liens de téléchargement) ; la clé d'écriture est sur le serveur de base.
Backups__Storage__Endpoint=https://s3.gra.io.cloud.ovh.net
Backups__Storage__Region=gra
Backups__Storage__Bucket=
Backups__Storage__AccessKeyId=
Backups__Storage__SecretAccessKey=

# --- Observabilité : 1.0 = toutes les traces ; 0.1 = une sur dix
Observability__TraceSampleRatio=0.2
